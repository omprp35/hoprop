# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:replace_me

# Public Render URL, no trailing slash
PUBLIC_URL=https://your-service.onrender.com

# Random secret. Allowed chars for Telegram secret_token: A-Z a-z 0-9 _ -
TELEGRAM_WEBHOOK_SECRET=replace_with_a_long_random_secret

# Optional: only these Telegram chat IDs can run the bot. Comma-separated.
# Leave blank while testing if you do not know your chat ID yet.
AUTHORIZED_CHAT_IDS=

# Website your own automation should open
TARGET_URL=https://example.com

# Free Render: keep this as /tmp/browser-profile (ephemeral).
# Paid Render with a persistent disk mounted at /var/data: use /var/data/browser-profile
PROFILE_DIR=/tmp/browser-profile

# Extension directories inside this repository/container
CUSTOM_EXTENSION_DIR=/app/extensions/custom
SURFSHARK_EXTENSION_DIR=/app/extensions/surfshark

# Expected VPN country. IN = India
EXPECTED_COUNTRY=IN

# Manual browser session inactivity timeout in minutes (optional)
MANUAL_SESSION_MINUTES=15
