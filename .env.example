TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_URL=https://your-service.up.railway.app

# Recommended: mount a Railway Volume at /data
PROFILE_DIR=/data/browser-profile

CUSTOM_EXTENSION_DIR=/app/extensions/custom
SURFSHARK_EXTENSION_DIR=/app/extensions/surfshark

# Optional: comma-separated Telegram chat IDs. Leave blank while testing.
AUTHORIZED_CHAT_IDS=

# Live desktop login
DESKTOP_USERNAME=browser
DESKTOP_PASSWORD=change-this-to-a-strong-password

# Railway/nginx uses PORT; Node listens internally on APP_PORT.
APP_PORT=10001

# Signup automation uses the same browser/profile; no additional variables are required.
